# Production Settings
# CHANGE THIS before deploying. This default is provided only for quick start-up;
# reusing it lets anyone forge session cookies and bypass auth. Set a unique
# random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
APP_SECRET_KEY = "this is the secret key"
DISABLE_REGISTRATION = False
FLASK_ENV = "Production"
LOG_LEVEL = "INFO"
SESSION_TIMEOUT = "120"
MONGODB_URI = "mongodb://127.0.0.1:27017/"
MONGODB_DATABASE = "fwgui_database"