# Production Settings
# CHANGE THIS before deploying. This default is provided only for quick start-up;
# reusing it lets anyone forge session cookies and bypass auth. Set a unique
# random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
APP_SECRET_KEY = "this is the secret key"
DISABLE_REGISTRATION = False
# Keep "Production" for any network-reachable deployment. "Development" enables
# the Werkzeug debugger (remote code execution) and must only be used locally.
FLASK_ENV = "Production"
LOG_LEVEL = "INFO"
SESSION_TIMEOUT = "120"
# Set to "True" when the app is served over HTTPS (recommended for production)
# so the session cookie is only sent over HTTPS. Use "False" for plain-HTTP.
SESSION_COOKIE_SECURE = "True"
MONGODB_URI = "mongodb://127.0.0.1:27017/"
MONGODB_DATABASE = "fwgui_database"
# Collection holding user accounts (3.0.0+). Only change this if an existing
# install already has a user named "users".
# MONGODB_USERS_COLLECTION = "users"
# Pins the anonymous telemetry instance id instead of reading it from
# MongoDB. Leave unset for normal use; useful for CI or to keep one
# identity across a blue/green replacement.
# FWGUI_INSTANCE_ID = ""
