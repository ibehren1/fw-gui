# Development Settings
# CHANGE THIS before any non-local use. This default is provided only for quick
# start-up; reusing it lets anyone forge session cookies. Set a unique random
# value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
APP_SECRET_KEY = "this is the secret key"
DISABLE_REGISTRATION = False
FLASK_ENV = "Development"
LOG_LEVEL = "INFO"
SESSION_TIMEOUT = "120"
# Set to "True" only when the app is served over HTTPS (the session cookie will
# then be sent over HTTPS only). Leave "False" for plain-HTTP/local use.
SESSION_COOKIE_SECURE = "False"
MONGODB_URI = "mongodb://127.0.0.1:27017/"
MONGODB_DATABASE = "fwgui_database"
# Collection holding user accounts (3.0.0+). Only change this if an existing
# install already has a user named "users".
# MONGODB_USERS_COLLECTION = "users"
# Pins the anonymous telemetry instance id instead of reading it from
# MongoDB. Leave unset for normal use; useful for CI or to keep one
# identity across a blue/green replacement.
# FWGUI_INSTANCE_ID = ""
# The automatic weekly backup (3.0.0+) has no environment variables. It is off
# until enabled, and its day, hour and retention are set on the Admin Settings
# page and stored in MongoDB.
